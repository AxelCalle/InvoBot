# ─── Anthropic Claude API ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# ─── SUNAT API Oficial (Consulta de Validez de Comprobantes) ──────────────────
# Obtener desde SOL: Empresas > Comprobantes de pago > Consulta de Validez > Credenciales de API SUNAT
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=
# RUC de tu empresa (el consultante, no el emisor)
SUNAT_RUC_CONSULTANTE=

# ─── Tablas de Global Factoring (desarrollo usa sufijo _v4, producción sin sufijo) ──
GF_TABLE_COMPRAS=ADV_GLOFAC.dbo.CPCOMPRAS
GF_TABLE_COMPRASDET=ADV_GLOFAC.dbo.CPCOMPRASDET
GF_TABLE_CUENTAPAGAR=ADV_GLOFAC.dbo.CPCUENTAPAGAR
GF_TABLE_PROVEEDORES=ADV_GLOFAC.dbo.CPPROVEEDORES
GF_TABLE_DISTRITOS=ADV_GLOFAC.dbo.CDISTRITOS
GF_TABLE_TIPOCAMBIO=ADV_GLOFAC.dbo.CTIPOCAMBIO
# RUC de bancos conocidos, para la regla de comisiones bancarias (cuenta 946391)
RUC_BANCOS_CONOCIDOS=
# RUC de proveedores extranjeros conocidos que coinciden con formato peruano válido
RUC_EXTRANJEROS_CONOCIDOS=

# ─── Tablas de Global Go (SISCONT) ─────────────────────────────────────────────
ASIENTOS_TABLE_GGO=dbo.MDH_VOU
VOU_NUMERIC_GGO=1
PROVEEDORES_GGO=dbo.MDH_PC
TIPOCAMBIO_GGO=dbo.MDH_TC

# ─── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=info
# Secreto para firmar JWT de sesión (admin/usuario). Generar con crypto.randomBytes(48).
# NO compartir ni subir a git. Si se regenera, todas las sesiones activas se invalidan.
JWT_SECRET=
# Orígenes permitidos para llamadas cross-origin directas (fuera del gateway).
ALLOWED_ORIGINS=http://localhost:8080

# ─── SQL Server ────────────────────────────────────────────────────────────────
# La cadena de conexión vive en un .txt fuera del código fuente (ver db-connection.txt.example
# en la raíz del proyecto backend, un nivel arriba de src/).
# Solo usa esta variable si necesitas apuntar a otra ubicación del archivo:
#DB_CONNECTION_FILE=C:\ruta\a\db-connection.txt
